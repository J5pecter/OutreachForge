{
  "name": "outreachforge",
  "version": "0.1.0",
  "description": "Consent-based outreach & CRM platform. Import leads with a recorded lawful basis, personalize honestly, and send with suppression + one-click unsubscribe enforced.",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "scheduler": "node dist/scheduler.js",
    "scheduler:dev": "tsx watch src/scheduler.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test src/lib/template.test.ts src/modules/webhooks/verify.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@prisma/client": "^5.19.0",
    "bullmq": "^5.20.0",
    "csv-parse": "^5.5.6",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.14",
    "prisma": "^5.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4"
  }
}
