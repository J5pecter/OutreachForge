# ── Server ─────────────────────────────────────────────────────────────
PORT=4000
# Public base URL used to build unsubscribe + tracking links. Must be reachable
# by recipients for the one-click unsubscribe header to work.
PUBLIC_BASE_URL=http://localhost:4000

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://outreach:outreach@localhost:5432/outreach?schema=public

# ── Redis / queue ──────────────────────────────────────────────────────
# Required for sending: the send worker pulls jobs from here. Throttling and
# pacing live in Redis so they hold across multiple worker processes.
REDIS_URL=redis://localhost:6379
# How many messages a single worker process sends concurrently. The global
# hourly ceiling (SEND_MAX_PER_HOUR) is enforced across ALL workers regardless.
SEND_WORKER_CONCURRENCY=5
# Run the send worker + scheduler inside the API process (true) for a single
# free-tier host, instead of as separate `npm run worker`/`scheduler` services.
RUN_WORKER_IN_PROCESS=false

# ── Cross-origin (hosted split) ────────────────────────────────────────
# Browser origin(s) allowed to call the API — the hosted dashboard. Comma-
# separated or '*'. Empty = same-origin only. e.g. https://your-site.netlify.app
CORS_ORIGIN=

# ── Auto-dispatch scheduler ────────────────────────────────────────────
# Run `npm run scheduler` to enable automatic sending: it enqueues each active
# campaign's fair share every tick, so you only need to QUEUE a campaign.
AUTO_DISPATCH_INTERVAL_SECONDS=60
AUTO_DISPATCH_MAX_PER_TICK=500
# Optional quiet hours (server local time, 24h). Default 0–24 = always open.
# Example: only enqueue new batches between 9am and 6pm:
#   SEND_WINDOW_START_HOUR=9
#   SEND_WINDOW_END_HOUR=18
SEND_WINDOW_START_HOUR=0
SEND_WINDOW_END_HOUR=24

# ── Mobile approval ────────────────────────────────────────────────────
# Where the "Approve & send" link is delivered when a campaign requires
# approval. Telegram is best for phone (free, instant): message @BotFather to
# make a bot for the token, and get your chat id from @userinfobot.
# If neither Telegram nor APPROVAL_EMAIL is set, the link is returned by the
# API and logged. PUBLIC_BASE_URL must be reachable from your phone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APPROVAL_EMAIL=

# ── AI personalization (optional) ──────────────────────────────────────
# Provider is auto-selected: GEMINI_API_KEY wins, else ANTHROPIC_API_KEY, else
# template-only ({{ai}} renders empty — free, no LLM calls). Campaigns with AI
# enabled generate one fact-grounded sentence per recipient at {{ai}}.
#
# FREE option: get a Gemini key at https://aistudio.google.com/apikey (no card,
# ~1,500 personalizations/day on the free tier).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override. Defaults: gemini-1.5-flash (Gemini) / claude-opus-4-8
# (Anthropic). For paid Claude at high volume, claude-haiku-4-5 is far cheaper.
AI_MODEL=
AI_MAX_TOKENS=160
AI_CONCURRENCY=5
AI_TIMEOUT_MS=20000

# ── Sending provider ───────────────────────────────────────────────────
# One of: dryrun | smtp
# dryrun (default) renders and logs messages WITHOUT sending anything. Use it
# until you have verified domain authentication (SPF/DKIM/DMARC) and consent.
MAIL_PROVIDER=dryrun

# Default From identity. The domain here MUST have SPF, DKIM and DMARC configured.
MAIL_FROM_NAME=Your Company
MAIL_FROM_EMAIL=hello@example.com
# Address that receives replies + unsubscribe confirmations.
MAIL_REPLY_TO=hello@example.com

# SMTP settings (used when MAIL_PROVIDER=smtp). Point these at a reputable ESP
# relay (SendGrid, Amazon SES, Mailgun, Postmark) — do not use ad-hoc relays.
#
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey (the
# literal word), SMTP_PASS=<your SendGrid API key>. MAIL_FROM_EMAIL must be a
# sender you verified in SendGrid (ideally a domain-authenticated address, so
# SPF/DKIM pass and mail reaches the inbox instead of spam).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ── Sending policy ─────────────────────────────────────────────────────
# Global ceiling. Deliverability comes from sending wanted mail slowly to a
# warm domain — not from volume. Keep this conservative on new domains.
SEND_MAX_PER_HOUR=200
# Refuse to enqueue a campaign larger than this in one run (safety rail).
CAMPAIGN_MAX_RECIPIENTS=5000

# ── ESP webhooks (bounce / complaint auto-suppression) ─────────────────
# Optional shared secret required as ?token=... on webhook calls (defense in
# depth on top of signature verification below).
WEBHOOK_TOKEN=
# SendGrid Event Webhook: paste the base64 "Verification Key" from the SendGrid
# UI. When set, requests without a valid ECDSA signature are rejected (401).
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Verify RSA signatures on inbound Amazon SNS messages against the AWS signing
# certificate. Leave true in production; set false only for local fake payloads.
SNS_VERIFY_SIGNATURE=true
# Auto-complete the SNS subscription handshake by fetching the SubscribeURL.
SES_SNS_AUTO_CONFIRM=false
